# Normalize text files to LF in the repository and working tree.
* text=auto eol=lf

# Keep common binary assets out of text conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.wasm binary
