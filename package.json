{
  "name": "workbench",
  "private": true,
  "description": "Full-stack starter: TanStack Start frontend + Convex backend",
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend run test",
    "format": "npm --prefix frontend run format",
    "check": "npm --prefix frontend run check"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
